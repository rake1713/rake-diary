[Unit]
Description=Дневник смен водителя (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
User=rakediary
Group=rakediary
WorkingDirectory=/opt/rake-diary
Environment=DIARY_ENV=prod
Environment=DIARY_HOST=127.0.0.1
Environment=DIARY_PORT=8000
Environment=DIARY_FORWARDED_ALLOW_IPS=127.0.0.1
Environment=DIARY_DB_PATH=/var/lib/rake-diary/diary.db
Environment=DIARY_SEED_PATH=/opt/rake-diary/data/trips.json
Environment=DIARY_WEB_DIR=/opt/rake-diary/web
EnvironmentFile=-/etc/rake-diary.env
ExecStart=/opt/rake-diary/backend/.venv/bin/diary
Restart=on-failure
RestartSec=3

StateDirectory=rake-diary
StateDirectoryMode=0700
MemoryMax=256M
CPUQuota=50%
TasksMax=64

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
